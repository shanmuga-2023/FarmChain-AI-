# ==========================================================
# 🌾 FarmChain AI 2.0 — Backend Environment Variables
# (Used by Node.js / Express Server)
# ==========================================================

# Server Listening Port (Render/Railway sets PORT automatically in production)
PORT=4000
NODE_ENV=production

# ----------------------------------------------------------
# 1. Polygon Amoy Blockchain & Smart Contract
# ----------------------------------------------------------
# Deployed AgriSupplyChain contract address on Polygon Amoy
AGRI_CONTRACT_ADDRESS=0xEfAE2C6BBE660F2Ebd22C09D6f04394aF0a4738A

# Polygon Amoy RPC endpoint (Chain ID: 80002)
POLYGON_AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
CHAIN_ID=80002

# Server-side Relayer / Admin Wallet Private Key (MetaMask export)
# Required if the backend mints or signs transactions on behalf of users.
# Keep strictly secret — NEVER commit to version control!
BLOCKCHAIN_PRIVATE_KEY=

# Public Deployer / Admin Wallet Address (for reference)
DEPLOYER_ADDRESS=0xFee2B36737BDdBB3AB8C0924B013f898e512715F

# ----------------------------------------------------------
# 2. Firebase Admin SDK Configuration
# ----------------------------------------------------------
FIREBASE_PROJECT_ID=farmchainai

# Optional: Full service account JSON string if using Firestore / Firebase Admin in production:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"farmchainai",...}
