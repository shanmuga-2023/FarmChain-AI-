# ==========================================================
# 🌿 FarmChain AI 2.0 — Frontend Environment Variables
# (Used by Vite — All browser variables MUST start with VITE_)
# ==========================================================

# ----------------------------------------------------------
# 1. Backend API & Live WebSocket URL
# ----------------------------------------------------------
# Local development:
# VITE_API_URL=http://localhost:4000/api
# Production deployment (e.g., Render / Railway / Heroku):
VITE_API_URL=https://farmchain-ai-1oge.onrender.com/api

# Enable backend integration ('true' or 'false')
VITE_USE_BACKEND=true

# ----------------------------------------------------------
# 2. Polygon Amoy Blockchain Network (Chain ID: 80002)
# ----------------------------------------------------------
