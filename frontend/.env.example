# Testnet RPC provider (High-availability public RPC)
VITE_POLYGON_AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# Polygon Amoy Chain ID (80002)
VITE_CHAIN_ID=80002

